# Shared by every service - see shared/config/env.js. In production each
# service would pull these from AWS Secrets Manager instead of a file.
MONGO_URI=mongodb://127.0.0.1:27017/streamline
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
CORS_ORIGIN=http://localhost:5173

# Local dev stands in for AWS. Swap points for production:
#   UPLOAD_DIR (local disk)      -> S3 raw + processed buckets, uploaded via presigned URL
#   /uploads route (catalog-svc) -> CloudFront distribution with signed URLs (see docs)
#   no transcoding in this repo  -> AWS MediaConvert, triggered by an SQS worker
UPLOAD_DIR=uploads

# Used only by the seed script (backend/scripts/seed.js) to pull real
# movies/shows/posters from TMDB. Get a free key at
# themoviedb.org/settings/api. Playback still uses sample video files -
# TMDB has no streamable video, only metadata/artwork.
TMDB_API_KEY=

# Used to remux uploaded videos (e.g. .mkv) into .mp4 so the browser's
# <video> tag can actually play them - see shared/utils/videoRemux.js.
# Requires ffmpeg to be installed; "ffmpeg" works once it's on PATH, or
# point this at the full exe path.
FFMPEG_PATH=ffmpeg

# Service ports (local dev). GATEWAY_PORT must stay 4000 - the frontend's
# vite.config.js proxy target is hardcoded to http://localhost:4000, so
# changing this alone silently breaks every API call from the UI.
GATEWAY_PORT=4000
AUTH_SERVICE_PORT=4001
CATALOG_SERVICE_PORT=4002
ENGAGEMENT_SERVICE_PORT=4003
SUBSCRIPTION_SERVICE_PORT=4004

# How the gateway (and auth-service, for its analytics call) find each
# service. In production these become internal ALB/service-discovery
# DNS names instead of localhost ports.
AUTH_SERVICE_URL=http://localhost:4001
CATALOG_SERVICE_URL=http://localhost:4002
ENGAGEMENT_SERVICE_URL=http://localhost:4003
SUBSCRIPTION_SERVICE_URL=http://localhost:4004
